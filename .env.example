# =============================================================================
# GA4 MCP Server — environment for the Dokploy deployment.
# Copy these into the Dokploy "Environment" tab and fill in the values.
#
# The image starts `analytics-mcp --transport http --host 0.0.0.0`; every
# other switch is read from the variables below (see `analytics-mcp --help`).
# =============================================================================

# --- Personal Google login (OAuth 2.1 server proxying Google OAuth) ----------
ANALYTICS_MCP_OAUTH=true

# OAuth 2.0 client of type "Web application" from the Google Cloud project
# (APIs & Services > Credentials). Enable the Analytics Admin API and the
# Analytics Data API in the same project.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Public HTTPS base URL behind Traefik (no trailing slash). Add
#   <ANALYTICS_MCP_ISSUER_URL>/oauth/callback
# as Authorized redirect URI of the OAuth client.
ANALYTICS_MCP_ISSUER_URL=https://ga4-mcp.touchpoint.agency

# --- Usage log ----------------------------------------------------------------
# Records every tool call (user, tool, property, outcome) to the tool_call
# table. The server refuses to start when the DSN is missing.
ANALYTICS_MCP_USAGE_LOG=true
MCP_USAGE_DSN=postgresql://user:password@host:5432/mcp_usage?sslmode=require

# --- Server binding -----------------------------------------------------------
# The image defaults to 8080; keep 8000 so the existing Dokploy mapping holds.
PORT=8000

# Set in the image already; harmless for a single container.
# ANALYTICS_MCP_STATELESS_HTTP=true

# Tools that modify Analytics resources stay off unless explicitly enabled.
# ANALYTICS_MCP_ALLOW_WRITE=false
